{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veira",
  "compatibility_date": "2025-09-27",
  // Maintenance mode: worker/maintenance.js answers every request with a
  // holding page. Remove `main` and `assets.run_worker_first` to restore the site.
  "main": "worker/maintenance.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
